#!/bin/sh
# Refuse pushes whose HEAD carries a Cargo.toml/Cargo.lock inconsistency.
#
# Mechanism this fences (hit twice in one day, hours apart): a cargo command run
# without --locked quietly updates the WORKING-TREE lockfile, so local --locked
# gates pass while the COMMIT being pushed lacks the lock line -- every --locked
# build on master then fails, and the finder's symptom is a mystifying dirty
# Cargo.lock after a read-only command. Checking the commit's own tree (not the
# working tree) is the property that matters.
# git hands the pushed refs on stdin: `<local ref> <local sha> <remote ref>
# <remote sha>` per line. Check the sha being PUSHED, not the checkout's HEAD:
# under train branches the two differ, and a branch deletion (local sha all
# zeros) carries no tree to check at all — running the gate on HEAD for a
# deletion is wasted seconds on every train cleanup.
zero=0000000000000000000000000000000000000000
pushed=""
while read -r _ local_sha _ _; do
  [ -n "$local_sha" ] && [ "$local_sha" != "$zero" ] && pushed="$local_sha"
done
# No stdin (a direct invocation) falls back to HEAD; a deletion-only push
# leaves `pushed` empty and skips the lock check.
[ -n "$pushed" ] || { [ -t 0 ] && pushed=$(git rev-parse HEAD); }
if [ -n "$pushed" ]; then
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  # Archive the WHOLE tree: a hardcoded path roster here decayed the day a new
  # top-level crate dir (cortexkit-release) appeared — the extraction lacked a
  # declared workspace member and cargo metadata failed on a phantom, refusing
  # a correct push. Whole-tree costs a moment more and cannot rot.
  if git archive "$pushed" 2>/dev/null | tar -x -C "$tmp" 2>/dev/null; then
    if ! (cd "$tmp" && cargo metadata --locked --format-version 1 >/dev/null 2>&1); then
      echo "pre-push: the pushed commit's Cargo.lock does not match its manifests (run cargo update -w or commit the lock)" >&2
      exit 1
    fi
    # SECOND ARM, and it is not belt-and-braces: the two questions PRODUCE EACH
    # OTHER (FUSI, 2026-09-18). The remediation for the arm above -- stage
    # explicit paths so a toolchain's lock rewrite does not ride along -- is
    # exactly what leaves a CURRENT tree beside a STALE commit. And the
    # remediation for that (commit the rewritten lock) is what produces the
    # first. So:
    #
    #   archive resolve   does the COMMIT's lock resolve
    #   cmp equality      is the tree the same file I actually gated against
    #
    # Without this, every local gate can pass against a working tree while the
    # verdict is reported about a different file. Same shape as the
    # gate-rewrites-its-own-inputs rule: tree clean after the gate is what makes
    # the verdict be about the commit.
    # Only when the pushed commit IS the checkout's HEAD: the working tree is
    # what was gated only then. Pushing a tag on an older commit, or any ref
    # that is not HEAD, compares that commit's lock with a newer working tree
    # and refused every such push, a correct one included.
    pushed_commit=$(git rev-parse --verify --quiet "$pushed^{commit}" || :)
    if [ "$pushed_commit" = "$(git rev-parse HEAD)" ] && [ -f Cargo.lock ] \
      && ! cmp -s "$tmp/Cargo.lock" Cargo.lock; then
      echo "pre-push: the working-tree Cargo.lock differs from the commit being pushed --" >&2
      echo "          your local gates verified a file that is not going to origin." >&2
      echo "          git diff HEAD -- Cargo.lock, then commit it or restore it." >&2
      exit 1
    fi
  fi
fi

# Fire-from-the-bump (three consecutive nightly lock waves, E2E evidence):
# a version bump in ANY workspace crate re-stales every path-dep sibling's
# committed Cargo.lock the moment it lands, with no signal in the sibling's
# repo, and sibling deploy ladders that build from working trees are blind
# to it BY CONSTRUCTION (ALF's find). The nightly reports it at 04:00 as a
# red master; this prints the fan-out AT THE PUSH so the announcement is
# generated by the bump itself rather than remembered (procedural rules
# fail under pressure -- measured, instance six). Advisory: never blocks.
# The notice carries the pushed sha because consumers' first check is
# "was the bump real and the tree clean" (FUSI's property) -- a sha they
# can cite answers it without re-derivation.
  # BLIND SPOT FOUND BY BROCA (2026-09-19): deriving targets from a
  # `crates/<name>/` shape makes every version-carrying file OUTSIDE that
  # prefix gate nothing when edited alone. Measured here: cortexkit-release is
  # a workspace member at the repo root, and three npm packages under clients/
  # carry versions consumers pin. A path-glob derivation is a CLAIM ABOUT
  # LAYOUT, and the layout it describes is never the whole repo.
  bump_globs='crates/*/Cargo.toml cortexkit-release/Cargo.toml clients/*/package.json'
range_bumps=$(git diff "@{push}...HEAD" -- $bump_globs 2>/dev/null \
  | grep -cE '^\+ *"?version"? *[=:]' | tr -d ' ')
if [ "${range_bumps:-0}" -gt 0 ]; then
  echo "" >&2
  echo "pre-push NOTICE: pushing $(git rev-parse --short HEAD) with $range_bumps workspace crate version bump(s):" >&2
  git diff "@{push}...HEAD" -- $bump_globs 2>/dev/null \
    | grep -E '^(diff --git|\+ *"?version"? *[=:])' | sed 's|diff --git a/|  |;s| b/.*||' >&2
  echo "  EVERY path-dep sibling's committed lock is stale from this moment." >&2
  echo "  Fan out now: bash scripts/fleet/check-sibling-locks.sh for the list," >&2
  echo "  then peer-notify owners. Fix recipe to send: cargo update -w against" >&2
  echo "  the ON-DISK sibling after checking its declared version -- never an" >&2
  echo "  unconditional pull (the shared checkout may hold others' WIP; a clean" >&2
  echo "  merge over it is a silent failure). Name any NEWLY REQUIRED fields in" >&2
  echo "  the notice so mid-task workers don't satisfy the compiler with values" >&2
  echo "  that aren't true. Consumers must verify against the COMMITTED lock" >&2
  echo "  (git show HEAD:Cargo.lock | grep -A1 <crate>), not the working file:" >&2
  echo "  any plain cargo build silently refreshes the working lock, so" >&2
  echo "  'cargo check --locked' passing absolves a repo whose committed lock" >&2
  echo "  is still stale (CKCRED hit exactly this). A lock-only commit still" >&2
  echo "  CHANGES THE BINARY's declared identity: build_lock_digest hashes the" >&2
  echo "  on-disk Cargo.lock, so a module that absorbs the wave but skips its" >&2
  echo "  next deploy declares the PRE-wave digest -- ck provenance reads" >&2
  echo "  plausibly and is wrong (QTA proved this across a zero-source-line" >&2
  echo "  commit). Deploy-after-lock-commit is part of the absorb, not optional" >&2
  echo "  -- UNLESS your module passes build_lock_digest: None (nothing reads" >&2
  echo "  the lock at build time; a lock-only commit leaves your binary" >&2
  echo "  byte-identical). Decide EMPIRICALLY, not by reading build.rs (a" >&2
  echo "  build.rs can exist and not read the lock, or read it and pass None):" >&2
  echo "  (1) determinism control -- rebuild ONE commit twice, hashes identical" >&2
  echo "  (skipping this makes any inequality meaningless: could be build" >&2
  echo "  nondeterminism); (2) build both commits with stamp overrides set" >&2
  echo "  identically, compare. The hashes answer the actual question." >&2
  echo "  Two facts about the NOTICE itself: it describes THIS wave's delta," >&2
  echo "  and a consumer may be several waves behind -- what it reaches in" >&2
  echo "  their tree only their own lock knows (WERNI absorbed a bump no" >&2
  echo "  notice ever named for them). And a MISSED wave leaves no trace" >&2
  echo "  except ' M Cargo.lock' in git status, because the next build heals" >&2
  echo "  the working copy -- green gate, working binary, several waves" >&2
  echo "  behind, nothing on any surface saying so. The committed-lock check" >&2
  echo "  is not step ordering; it is the ONLY detector for a wave that was" >&2
  echo "  never applied (QTA was two waves behind with every gate green)." >&2
  echo "  Consumers: after cargo update -w, diff the ACTUAL lock delta against" >&2
  echo "  the announced one and reconcile before committing (CKCRED). The" >&2
  echo "  announced FROM is the announcer's previous state; a skipped hop makes" >&2
  echo "  your travelled distance LARGER than the announced delta, and any" >&2
  echo "  'lock-only / no construct change' assurance covers the ANNOUNCED hop" >&2
  echo "  only -- the skipped hops may carry features. Bound skipped-hop risk" >&2
  echo "  by dependency shape (dev-dep vs linked), not by the assurance." >&2
  # BROCA pin verdict, DERIVED not recalled: broca pins subtree hashes of the
  # three crates it links in SUBC_COMPAT (TREE lines). Three notices in one
  # day carried a wrong recollection of that pin set; a claim rebuilt from
  # memory at send time is the same defect class we hunt in code. Read the
  # artifact instead -- it stays correct when their pin set changes without
  # either repo noticing.
  BROCA_COMPAT="$(git rev-parse --show-toplevel)/../broca/SUBC_COMPAT"
  if [ -f "$BROCA_COMPAT" ]; then
    echo "" >&2
    echo "  BROCA pin verdict (derived from broca/SUBC_COMPAT TREE lines):" >&2
    moved=0
    while read -r _ crate pinned; do
      [ -n "$crate" ] || continue
      current=$(git rev-parse "HEAD:crates/$crate" 2>/dev/null) || continue
      if [ "$current" = "$pinned" ]; then
        echo "    $crate: unchanged since broca's pin" >&2
      else
        echo "    $crate: TREE MOVED since broca's pin -- name it in their notice" >&2
        moved=1
      fi
    done <<BROCA_PINS
$(grep '^TREE ' "$BROCA_COMPAT")
BROCA_PINS
    [ "$moved" = 0 ] && echo "    (all pinned trees unchanged: broca notice can say no-op)" >&2
  fi
fi
# ---- IN-FLIGHT CI: name what this push is about to cancel ----
#
# GitHub's cancel-in-progress kills the older run on the same branch, so a push
# on top of a run in flight destroys twenty minutes of matrix work and the loss
# is SILENT -- the watcher on the older sha reports "cancelled", which reads as
# a CI fault rather than as something the operator did. Four times in one day
# (2026-09-18), each time after banking the rule, because a rule you have to
# remember is applied to whatever you are attending to and this is never it.
#
# A WARNING RATHER THAN A REFUSAL, deliberately: superseding an in-flight run is
# often exactly right (a fix commit for a red run should not wait for the red to
# finish). The failure being fixed is not "cancelling" but "cancelling without
# knowing", so this converts a silent loss into a stated one.
#
# Degrades silently when gh is absent, unauthenticated, or offline: a pre-push
# hook must not depend on the network to let you push.
if command -v gh >/dev/null 2>&1; then
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  inflight=$(gh run list --branch "$branch" --event push --limit 5 \
      --json status,headSha,workflowName \
      --jq '.[] | select(.status=="in_progress" or .status=="queued") | "\(.headSha[0:8]) \(.workflowName)"' \
      2>/dev/null | head -3)
  # A SCHEDULED RED REPORTS TO NOBODY, so carry it on the next push.
  #
  # A push gate answers "is this change good" and you read it BECAUSE you just
  # pushed. A scheduled run answers "is what already landed still good against
  # the world as it is now" -- and its whole value is firing when you are not
  # looking, which is exactly why its RESULT arrives when you are not looking.
  #
  # Measured here 2026-09-19 after FUSI found the same hole: SIX consecutive
  # scheduled reds, 2026-09-07 to 2026-09-12, none of which I ever saw. They were
  # the Windows breakage I was separately chasing on pushes, and they went green
  # when I fixed it -- the signal worked perfectly and told nobody.
  #
  # A NOTICE, NOT A REFUSAL: a scheduled red is about what already landed, the
  # push in front of you may well be its fix, and blocking unrelated work on it
  # would be wrong. It reappears on EVERY push until the schedule goes green, so
  # unlike a one-shot notification it cannot be missed by being away.
  #
  # ALSO REPORTS "no scheduled runs at all", because a cron that never fires
  # produces exactly the same silence as one that passes.
  # GRADE THE NEWEST NON-CANCELLED SAMPLE, NEVER JUST THE NEWEST.
  #
  # This read `--limit 1`. With a ref-scoped concurrency group, a master push
  # that overlaps the ~10:30Z cron CANCELS it -- four of my own six "scheduled
  # reds" turned out to be exactly that. So the newest row is cancelled roughly
  # a third of the mornings I am busy, and a `cancelled` top row correctly
  # declines to be a verdict and THEN PRINTS NOTHING, hiding yesterday's real
  # failure behind it. BROCA proved it on that exact two-row input.
  #
  #   A VALUE CORRECTLY CLASSIFIED AS "NOT A VERDICT" IS NOT A STOPPING POINT.
  #   Skipping it is the whole job; stopping at it inherits its silence.
  #
  # And the hiding is anti-correlated with attention: the busier the push day,
  # the likelier the cancel, so a red survives unseen precisely when a lock wave
  # is most likely to have landed.
  sched=$(gh run list --event schedule --limit 10 \
      --json conclusion,createdAt,headSha \
      --jq '[.[] | select(.conclusion != "cancelled" and .conclusion != "")][0]
            | "\(.conclusion) \(.createdAt[0:16]) \(.headSha[0:8])"' 2>/dev/null || true)
  if [ -z "${sched:-}" ]; then
    # Distinguish "every sample was cancelled" from "the cron never fires": both
    # produce an empty grade, and only the second is a broken schedule.
    sched_any=$(gh run list --event schedule --limit 10 --json conclusion \
        --jq 'length' 2>/dev/null || echo 0)
    if [ "${sched_any:-0}" -gt 0 ] 2>/dev/null; then
      echo "" >&2
      echo "pre-push NOTICE: all ${sched_any} recent SCHEDULED runs were cancelled --" >&2
      echo "  the samples were never taken. Your pushes are landing in the cron window." >&2
    fi
  fi
  # A CRON THAT STOPPED FIRING LEAVES A GREEN LAST RUN, so conclusion alone is
  # not enough: a schedule that ran for months, went green, and then stopped
  # (workflow renamed, default branch moved, repo activity-disabled after 60
  # days) reports exactly what a healthy one reports. Age is the discriminator.
  #
  # 48h rather than 24h because GitHub's scheduler is LATE AND VARIABLE. The
  # bound is now DERIVED rather than guessed, which it was when first written:
  #
  #   floor = one cron period (24h) + the observed maximum delay
  #         = 24h + 5h36m ~= 29.6h      ->  48h clears it with margin
  #
  # Measured 2026-09-20, three repos, raw distributions not summaries:
  #   subconscious  `0 6`   n=14  mean +4h19m  range +3h40m..+5h02m
  #   fusiform      `0 6`   n=13  mean +4h31m  range +3h50m..+5h19m
  #   cerebellum    `17 4`  n=14  mean +4h54m  range +4h22m..+5h36m
  #
  # An earlier version of this comment said CEREB measured "~09:00Z on all
  # twelve". That was wrong twice -- n was 14, and the deliveries run 08:38Z to
  # 09:53Z with a 74-minute spread. I had rounded their spread to a point and
  # then carried the point into this bound, so a reader checking 48 against
  # "~09:00" could not see why 48 beat 24. A SUMMARY IS NOT A DISTRIBUTION.
  #
  # The three means sit 35 minutes apart, which is INSIDE one repo's own daily
  # spread, so the delay does not key on the popular `0` minute. It is a roughly
  # constant SHIFT rather than a fixed hour: cerebellum declares 04:17 and lands
  # 08:38-09:53Z while the other two declare 06:00 and land ~10:20-10:30Z --
  # different absolute bands, which rules out "everything runs at 09:00Z".
  # NOT ruled out: an org- or plan-level queue. All three repos share both, and
  # that would produce exactly this agreement.
  #
  # A 24h bound would fire on a healthy queue delay, and an alarm that fires on
  # healthy work gets muted. THE NUMBER TO RE-DERIVE IF ANYTHING MOVES IS THE
  # OBSERVED MAXIMUM, not the declared cron: this arm's subject is a WINDOW, so
  # sizing it from the schedule rather than the delivery distribution is the
  # defect (FUSI's discriminator: a check whose subject is "the newest thing,
  # whenever it was" is immune; one whose subject is a window is not, and they
  # look identical from outside).
  # Age uses the newest run of ANY conclusion, deliberately: a cancelled run is
  # still evidence the scheduler FIRED, which is what this arm measures. Grading
  # and liveness are different questions and want different populations.
  sched_age_h=$(gh run list --event schedule --limit 1 --json createdAt \
      --jq '.[0].createdAt' 2>/dev/null \
    | { read -r ts; [ -n "$ts" ] && python3 -c "
import sys,datetime
t=datetime.datetime.fromisoformat('$ts'.replace('Z','+00:00'))
print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()//3600))
" 2>/dev/null || true; })
  if [ -n "${sched_age_h:-}" ] && [ "$sched_age_h" -gt 48 ] 2>/dev/null; then
    echo "" >&2
    echo "pre-push NOTICE: the last SCHEDULED run is ${sched_age_h}h old." >&2
    echo "  A cron that stopped firing leaves a green last run and looks healthy." >&2
  fi
  if [ -z "$sched" ]; then
    if grep -q "schedule:" "$(git rev-parse --show-toplevel)/.github/workflows/"*.yml 2>/dev/null; then
      echo "" >&2
      echo "pre-push NOTICE: a cron is declared but NO scheduled run exists." >&2
      echo "  A schedule that never fires looks exactly like one that passes." >&2
    fi
  else
    # CANCELLED IS NOT RED -- it is a SAMPLE NEVER TAKEN, and conflating them
    # inflates the count and points at the wrong cause. The concurrency group is
    # `ci-${{ github.ref }}`, so a push to master and the morning cron SHARE it
    # and the push cancels the cron. Measured 2026-09-19: of six non-success
    # scheduled runs here, FOUR were cancelled by my own pushes and only two were
    # genuine failures. I published "six reds" to the fleet twice before reading
    # one of the logs.
    #
    # The cancelled case is not a defect to fix: the push run that cancelled it
    # tests a newer tip against the same siblings, so it answers the same
    # question. It is a MISSING SAMPLE, not a missed failure, and the operator
    # needs those worded differently.
    case "$sched" in
      success*) : ;;
      cancelled*)
        echo "" >&2
        echo "pre-push NOTICE: the last SCHEDULED run was CANCELLED, not failed:" >&2
        echo "  $sched" >&2
        echo "  A push shares the concurrency group with the cron, so the sample" >&2
        echo "  was never taken. Not a red. The push run that cancelled it covers" >&2
        echo "  the same question against a newer tip." >&2
        ;;
      *)
        echo "" >&2
        echo "pre-push NOTICE: the last SCHEDULED run FAILED:" >&2
        echo "  $sched" >&2
        echo "  It answers 'is what already landed still good', and it reports to nobody." >&2
        echo "  gh run list --event schedule --limit 10 --json conclusion,createdAt,headSha" >&2
        ;;
    esac
  fi

  if [ -n "$inflight" ]; then
    echo "" >&2
    echo "pre-push NOTICE: a CI run is IN FLIGHT on $branch and this push will cancel it:" >&2
    echo "$inflight" | sed 's/^/  /' >&2
    echo "  (cancel-in-progress kills the older run; its watcher will report 'cancelled')" >&2
  fi
fi
exit 0
