{
  // ckbus is supplied by cortexkit-bus-testkit; these are ck-bus-specific controls.
  "version": 1,
  "modules": {
    "nats-server": {
      "program": "nats-server",
      "args": ["--port", "0", "--name", "ckbus-acceptance-final-argument"],
      "enabled": false,
      "protocol": "none",
      "drain_timeout_ms": 2000
    },
    "standin-none": {
      "program": "crates/ck-bus/tests/support/standin_child.sh",
      "args": ["standin-none-final-argument"],
      "enabled": false,
      "protocol": "none",
      "drain_timeout_ms": 2000
    },
    "standin-default-protocol": {
      "program": "crates/ck-bus/tests/support/standin_child.sh",
      "args": ["standin-default-final-argument"],
      "enabled": false,
      "drain_timeout_ms": 2000
    },
    // Negative control: ignores SIGTERM, so it must be killed at its (short) budget.
    "standin-ignores-term": {
      "program": "crates/ck-bus/tests/support/standin_ignores_term.sh",
      "args": ["standin-ignores-term-final-argument"],
      "enabled": false,
      "protocol": "none",
      "drain_timeout_ms": 500
    },
    "claustrum": {
      "program": "__CK_BUS_BIN__",
      "args": [],
      "enabled": false,
      "protocol": "subc"
    },
    "callosum": {
      "program": "__CK_BUS_BIN__",
      "args": [],
      "enabled": false,
      "protocol": "subc"
    }
  }
}
