#!/usr/bin/env bash
set -euo pipefail
umask 000

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
installer="$repo_root/scripts/install/install.sh"
test_root=$(mktemp -d)
trap 'rm -rf "$test_root"' EXIT
stub_dir="$test_root/stubs"
mkdir -p "$stub_dir"

fail() {
  printf 'test failure: %s\n' "$1" >&2
  exit 1
}

mode_of() {
  local mode
  mode=$(stat -f '%Lp' "$1" 2>/dev/null) || mode=$(stat -c '%a' "$1")
  printf '%s\n' "$mode"
}

assert_mode() {
  local path="$1"
  local expected="$2"
  local actual
  actual=$(mode_of "$path")
  [[ "$actual" == "$expected" ]] || fail "$path mode is $actual, expected $expected"
}

cat >"$stub_dir/uname" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  -s) printf '%s\n' "${CK_TEST_OS:-Linux}" ;;
  -m) printf '%s\n' "${CK_TEST_ARCH:-x86_64}" ;;
  -r) printf '%s\n' "${CK_TEST_KERNEL:-generic}" ;;
  *) exit 2 ;;
esac
EOF
cat >"$stub_dir/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
out=""
url=""
while (($# > 0)); do
  case "$1" in
    --output)
      out="$2"
      shift 2
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done
if [[ "${CK_TEST_ASSERT_TEMP_MODES:-0}" == "1" && "$url" == *index.json ]]; then
  stage_dir=$(dirname "$out")
  stage_mode=$(stat -f '%Lp' "$stage_dir" 2>/dev/null) || stage_mode=$(stat -c '%a' "$stage_dir")
  stage_owner=$(stat -f '%u' "$stage_dir" 2>/dev/null) || stage_owner=$(stat -c '%u' "$stage_dir")
  if [[ "$stage_mode" != "700" || "$stage_owner" != "$(id -u)" ]]; then
    printf 'test failure: staging directory mode/owner is %s/%s, expected 700/%s before file chmod\n' "$stage_mode" "$stage_owner" "$(id -u)" >&2
    exit 17
  fi
fi
printf '%s\n' "$url" >>"$CK_TEST_REQUEST_LOG"
if [[ "$url" == *index.json ]]; then
  if [[ "${CK_TEST_DOWNLOAD_FAILURE:-}" == "index" ]]; then
    exit 22
  fi
  digest=$(printf 'fixture archive\n' | shasum -a 256 | awk '{print $1}')
  if [[ "${CK_TEST_DIGEST_MISMATCH:-}" == "1" ]]; then
    digest=$(printf '%064d' 0)
  fi
  sha_json="\"$digest\""
  if [[ "${CK_TEST_DOWNLOAD_FAILURE:-}" == "sidecar" ]]; then
    sha_json=null
  fi
  ck_json="{\"url\":\"https://release.fixture.example/ck-ASSET.zip\",\"sha256\":$sha_json,\"bytes\":16,\"reports\":\"0.16.0\"}"
  if [[ "${CK_TEST_DOWNLOAD_FAILURE:-}" == "sidecar" && "${CK_TEST_OMIT_CK:-}" == "1" ]]; then
    ck_json="{}"
  fi
  cat >"$out" <<INDEX
{"schema":1,"channel":"alpha","generated_at_ms":1788425000000,"components":{"core":{"repository":"cortexkit/subconscious","release":"subc-core-v0.16.0","version":"0.16.0","assets":{"linux-x64":{"ck":{"url":"https://release.fixture.example/ck-linux-x64.zip","sha256":$sha_json,"bytes":16,"reports":"0.16.0"}},"darwin-arm64":{"ck":{"url":"https://release.fixture.example/ck-darwin-arm64.zip","sha256":$sha_json,"bytes":16,"reports":"0.16.0"}},"linux-arm64":{"ck":{"url":"https://release.fixture.example/ck-linux-arm64.zip","sha256":$sha_json,"bytes":16,"reports":"0.16.0"}}}}}}
INDEX
  if [[ "${CK_TEST_MISSING_ASSET:-}" == "1" ]]; then
    cat >"$out" <<'INDEX'
{"schema":1,"channel":"alpha","generated_at_ms":1788425000000,"components":{"core":{"repository":"cortexkit/subconscious","release":"subc-core-v0.16.0","version":"0.16.0","assets":{}}}}
INDEX
  fi
  exit 0
fi
if [[ "${CK_TEST_DOWNLOAD_FAILURE:-}" == "archive" ]]; then
  exit 22
fi
printf 'fixture archive\n' >"$out"
EOF
cat >"$stub_dir/unzip" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${CK_TEST_EXTRACTION_FAILURE:-}" == "1" ]]; then
  exit 9
fi
while (($# > 0)); do
  case "$1" in
    -d)
      destination="$2"
      shift 2
      ;;
    *)
      archive="$1"
      shift
      ;;
  esac
done
mkdir -p "$destination"
if [[ "${CK_TEST_ASSERT_TEMP_MODES:-0}" == "1" ]]; then
  mode_of() {
    local mode
    mode=$(stat -f '%Lp' "$1" 2>/dev/null) || mode=$(stat -c '%a' "$1")
    printf '%s\n' "$mode"
  }
  owner_of() {
    local owner
    owner=$(stat -f '%u' "$1" 2>/dev/null) || owner=$(stat -c '%u' "$1")
    printf '%s\n' "$owner"
  }
  expected_owner=$(id -u)
  [[ "$(mode_of "$destination")" == "700" ]] || {
    printf 'test failure: extraction directory is not private\n' >&2
    exit 13
  }
  [[ "$(mode_of "$(dirname "$destination")")" == "700" ]] || {
    printf 'test failure: staging directory is not private\n' >&2
    exit 14
  }
  [[ "$(owner_of "$destination")" == "$expected_owner" && "$(owner_of "$(dirname "$destination")")" == "$expected_owner" ]] || {
    printf 'test failure: staging directory is not owned by the current user before file chmod\n' >&2
    exit 18
  }
  [[ "$(mode_of "$archive")" == "600" ]] || {
    printf 'test failure: downloaded archive is not owner-only\n' >&2
    exit 15
  }
  [[ "$(mode_of "$(dirname "$archive")/index.json")" == "600" ]] || {
    printf 'test failure: downloaded index is not owner-only\n' >&2
    exit 16
  }
fi
cat >"$destination/ck" <<'CK'
#!/usr/bin/env bash
printf 'setup process started\n' >"$CK_TEST_SETUP_MARKER"
CK
EOF
cat >"$stub_dir/systemctl" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == "--user" ]]; then
  if [[ "${CK_TEST_SYSTEMD_RESULT:-0}" != "0" ]]; then
    printf 'systemd user session is unavailable\n' >&2
    exit 1
  fi
elif [[ "${CK_TEST_SYSTEMD_SYSTEM_RESULT:-0}" != "0" ]]; then
  printf 'systemd is not running\n' >&2
  exit 1
fi
if [[ "${1:-}" == "--user" || "${CK_TEST_SYSTEMD_SYSTEM_RESULT:-0}" == "0" ]]; then
  printf 'systemd user session\n'
  exit 0
fi
EOF
cat >"$stub_dir/chmod" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
target="$2"
stage_dir=$(dirname "$target")
stage_mode=$(stat -f '%Lp' "$stage_dir" 2>/dev/null) || stage_mode=$(stat -c '%a' "$stage_dir")
stage_owner=$(stat -f '%u' "$stage_dir" 2>/dev/null) || stage_owner=$(stat -c '%u' "$stage_dir")
expected_owner=$(id -u)
if [[ "$stage_mode" != "700" || "$stage_owner" != "$expected_owner" ]]; then
  printf 'test failure: chmod target %s has staging directory mode/owner %s/%s, expected 700/%s\n' "$target" "$stage_mode" "$stage_owner" "$expected_owner" >&2
  exit 19
fi
exec /bin/chmod "$@"
EOF
chmod +x "$stub_dir/uname" "$stub_dir/curl" "$stub_dir/unzip" "$stub_dir/systemctl" "$stub_dir/chmod"

run_installer() {
  local home="$1"
  local output_file="$2"
  shift 2
  if ! env \
    HOME="$home" \
    USERPROFILE="$home/userprofile" \
    LOCALAPPDATA="$home/localappdata" \
    XDG_DATA_HOME= \
    XDG_CONFIG_HOME="$home/.config" \
    XDG_RUNTIME_DIR="$home/run" \
    CK_PROFILE_PATH= \
    WSL_DISTRO_NAME= \
    SHELL=/bin/bash \
    PATH="$stub_dir:$PATH" \
    CK_RELEASE_INDEX_URL=https://release.fixture.example/releases/v1/index.json \
    CK_TEST_REQUEST_LOG="$home/requests.log" \
    CK_TEST_SETUP_MARKER="$home/setup-called" \
    CK_TEST_ASSERT_TEMP_MODES=1 \
    "$@" \
    bash "$installer" >"$output_file" 2>&1; then
    cat "$output_file" >&2
    return 1
  fi
}

legacy_home="$test_root/legacy-layout"
mkdir -p "$legacy_home/.local/share/cortexkit/bin" "$legacy_home/earlier"
/bin/chmod 700 "$legacy_home/.local/share/cortexkit"
legacy_bin="$legacy_home/.local/share/cortexkit/bin"
legacy_cmd="$legacy_home/.local/share/cortexkit/cmd"
printf 'old CLI\n' >"$legacy_bin/ck"
printf 'other old CLI\n' >"$legacy_home/earlier/ck"
printf 'module\n' >"$legacy_bin/ck-subc"
/bin/chmod +x "$legacy_bin/ck" "$legacy_home/earlier/ck"
run_installer "$legacy_home" "$legacy_home/output" PATH="$stub_dir:$legacy_home/earlier:$legacy_bin:$legacy_cmd:$PATH"
[[ -f "$legacy_home/earlier/ck" && "$(<"$legacy_home/earlier/ck")" == 'other old CLI' ]] || fail 'foreign_cli_untouched: a foreign CLI was moved or changed'
printf 'ok: foreign_cli_untouched\n'
[[ ! -e "$legacy_bin/ck" ]] || fail 'legacy_cli_retirement: old CLI still present'
[[ -f "$legacy_bin/ck-subc" ]] || fail 'legacy_cli_retirement: module removed'
python3 - "$legacy_home" <<'PY'
import hashlib, json, pathlib, sys
home = pathlib.Path(sys.argv[1])
rows = json.loads((home / '.local/share/cortexkit/installer-manifest.json').read_text())['mutations']
retired = [row for row in rows if row['kind'] == 'legacy-cli-retirement']
assert len(retired) == 1, 'legacy_cli_retirement: missing manifest row'
for row in retired:
    backup = pathlib.Path(row['backup_path'])
    assert backup.is_file() and '.retired-' in backup.name
    assert backup.read_text() == 'old CLI\n'
    assert row['original_path'] == str(home / '.local/share/cortexkit/bin/ck'), 'legacy_cli_retirement: original path missing'
    assert row['path'] == str(backup) and row['sha256'] == hashlib.sha256(backup.read_bytes()).hexdigest(), 'legacy_cli_retirement: backup path or digest differs'
PY
resolved=$(HOME="$legacy_home" PATH="$stub_dir:$legacy_bin:$legacy_cmd:$PATH" bash -c '. "$HOME/.bashrc"; type -P ck')
[[ "$resolved" == "$legacy_cmd/ck" ]] || fail "legacy_cli_retirement: shadowed by $resolved"
printf 'ok: legacy_cli_retirement\n'

foreign_home="$test_root/foreign-without-cmd"
mkdir -p "$foreign_home/outside"
printf 'operator CLI\n' >"$foreign_home/outside/ck"
/bin/chmod +x "$foreign_home/outside/ck"
run_installer "$foreign_home" "$foreign_home/output" PATH="$stub_dir:$foreign_home/outside:$PATH"
[[ -f "$foreign_home/outside/ck" && "$(<"$foreign_home/outside/ck")" == 'operator CLI' ]] || fail 'no_cmd_foreign_untouched: renamed an external CLI before cmd was on PATH'
printf 'ok: no_cmd_foreign_untouched\n'

guard_home="$test_root/interactive-profile"
mkdir -p "$guard_home"
printf 'case $- in *i*) ;; *) return ;; esac\n' >"$guard_home/.bashrc"
run_installer "$guard_home" "$guard_home/output" || fail 'bash_profile_interactive_guard: skipped the persisted PATH block'
printf 'ok: bash_profile_interactive_guard\n'

awk '/^if ! raw_os=/{exit} {print}' "$installer" >"$test_root/functions.sh"
selected=$(CK_PROFILE_PATH='' ZDOTDIR="$test_root/zsh-config" SHELL=/bin/zsh bash -c '. "$1"; select_profile; printf "%s" "$profile_path"' _ "$test_root/functions.sh")
[[ "$selected" == "$test_root/zsh-config/.zshrc" ]] || fail 'zsh_profile_location: ignored the directory a new zsh will read'
printf 'ok: zsh_profile_location\n'
shadow_home="$test_root/shadow"
mkdir -p "$shadow_home/old" "$shadow_home/cmd"
printf 'shadow\n' >"$shadow_home/old/ck"
/bin/chmod +x "$shadow_home/old/ck"
# Keep PATH literal until the fresh shell reads this profile.
# shellcheck disable=SC2016
printf 'readonly PATH="%s:$PATH"\n' "$shadow_home/old" >"$shadow_home/.bashrc"
if run_installer "$shadow_home" "$shadow_home/output"; then
  fail 'unix_cli_shadow_refusal: accepted an unresolved placement'
fi
grep -F "cli-shadowed: ck resolves to $shadow_home/old/ck" "$shadow_home/output" >/dev/null || fail 'unix_cli_shadow_refusal: shadowing path not named'
grep -F "PATH entry $shadow_home/old" "$shadow_home/output" >/dev/null || fail 'unix_cli_shadow_refusal: PATH entry not named'
[[ "$(<"$shadow_home/old/ck")" == shadow ]] || fail 'unix_cli_shadow_refusal: foreign CLI changed'
printf 'ok: unix_cli_shadow_refusal\n'

printf 'restored old CLI\n' >"$legacy_bin/ck"
/bin/chmod +x "$legacy_bin/ck"
run_installer "$legacy_home" "$legacy_home/output" PATH="$stub_dir:$legacy_bin:$legacy_cmd:$PATH"
run_installer "$legacy_home" "$legacy_home/output" PATH="$stub_dir:$legacy_cmd:$PATH"
python3 - "$legacy_home" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1]) / '.local/share/cortexkit'
rows = []
for name in ('installer-manifest.json', 'installer-manifest.bootstrap.json'):
    rows.extend(json.loads((root / name).read_text())['mutations'])
retired = [row for row in rows if row['kind'] == 'legacy-cli-retirement']
assert len(retired) == 2, 'retirement_history: pending history lost after PATH changed'
assert len({row['path'] for row in retired}) == 2, 'retirement_history: repeated source shares inventory key'
PY
printf 'ok: retirement_history\n'

alias_home="$test_root/alias-layout"
mkdir -p "$alias_home/.local/share/cortexkit/cmd"
/bin/chmod 700 "$alias_home/.local/share/cortexkit" "$alias_home/.local/share/cortexkit/cmd"
ln -s cmd "$alias_home/.local/share/cortexkit/bin"
run_installer "$alias_home" "$alias_home/output" PATH="$stub_dir:$alias_home/.local/share/cortexkit/bin:$PATH" || fail 'cli_directory_alias: installation failed through a directory alias'
[[ -f "$alias_home/.local/share/cortexkit/cmd/ck" ]] || fail 'cli_directory_alias: retired the new destination through bin'
printf 'ok: cli_directory_alias\n'

linux_home="$test_root/linux-home"
mkdir -p "$linux_home"
linux_output="$test_root/linux-output"
run_installer "$linux_home" "$linux_output" \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic

grep -Fq 'index.json' "$linux_home/requests.log" || fail 'Linux installer did not fetch the release index'
grep -Fq 'ck-linux-x64.zip' "$linux_home/requests.log" || fail 'Linux archive name was not requested'
grep -Fq 'Next: ck setup' "$linux_output" || fail 'installer did not print the setup command'
[[ ! -e "$linux_home/setup-called" ]] || fail 'installer started the extracted ck process'
[[ -x "$linux_home/.local/share/cortexkit/cmd/ck" ]] || fail 'installer did not place ck in cmd'
assert_mode "$linux_home/.local/share/cortexkit" 700
assert_mode "$linux_home/.local/share/cortexkit/cmd" 755
assert_mode "$linux_home/.local/share/cortexkit/cmd/ck" 755
assert_mode "$linux_home/.local/share/cortexkit/installer-manifest.json" 600
assert_mode "$linux_home/.bashrc" 600
[[ "$(grep -Fc '# cortexkit-managed PATH begin' "$linux_home/.bashrc")" == "1" ]] || fail 'PATH block was not recorded exactly once'
grep -Fq "$linux_home/.local/share/cortexkit/cmd" "$linux_home/.bashrc" || fail 'PATH block did not use cmd'
! grep -Fq "$linux_home/.local/share/cortexkit/bin" "$linux_home/.bashrc" || fail 'PATH block still includes bin'
grep -Fq 'installer-manifest.json' "$linux_home/.local/share/cortexkit/installer-manifest.json" || fail 'installer manifest did not record itself'
# The two digests must be the two different files: the archive digest the
# index carried (currency) and the extracted binary's own bytes (ownership).
# Asserting both by value, not just presence, is what catches a copy of one
# into the other.
archive_digest=$(printf 'fixture archive\n' | shasum -a 256 | awk '{print $1}')
binary_digest=$(shasum -a 256 "$linux_home/.local/share/cortexkit/cmd/ck" | awk '{print $1}')
[[ "$archive_digest" != "$binary_digest" ]] || fail 'fixture cannot discriminate: archive and binary digests coincide'
grep -Fq "\"archive_sha256\": \"$archive_digest\"" "$linux_home/.local/share/cortexkit/installer-manifest.json" || fail 'manifest did not record the archive digest the index carried'
grep -Fq "\"sha256\": \"$binary_digest\"" "$linux_home/.local/share/cortexkit/installer-manifest.json" || fail 'manifest did not record the placed binary digest'

# A re-run onto an installed machine. Stand in for `ck setup` by extending
# the manifest with a daemon row the way setup does (serde's own layout, so
# the file is nothing this script wrote). The re-run must not touch that
# file: the daemon row would be lost and `ck upgrade` would report the daemon
# as not installed. Its rows go to the sidecar the next ck load adopts.
linux_manifest="$linux_home/.local/share/cortexkit/installer-manifest.json"
linux_sidecar="$linux_home/.local/share/cortexkit/installer-manifest.bootstrap.json"
cat >"$linux_manifest" <<EOF
{
  "mutations": [
    {
      "archive_sha256": "stale-archive",
      "kind": "binary-placement",
      "path": "$linux_home/.local/share/cortexkit/cmd/ck",
      "sha256": "stale-binary"
    },
    {
      "archive_sha256": "daemon-archive",
      "kind": "binary-placement",
      "path": "$linux_home/.local/share/cortexkit/bin/ck-subc",
      "sha256": "daemon-binary"
    }
  ],
  "platform": "linux-x64",
  "schema_version": 1
}
EOF
manifest_before=$(shasum -a 256 "$linux_manifest" | awk '{print $1}')
rerun_output="$test_root/linux-rerun-output"
run_installer "$linux_home" "$rerun_output" \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic
grep -Fq 'already matches verified download' "$rerun_output" || fail 'identical destination was not reported as a no-op'
grep -Fq 'Next: ck setup' "$rerun_output" || fail 'no-op installer did not print the setup command'
[[ ! -e "$linux_home/setup-called" ]] || fail 'no-op installer started the extracted ck process'
[[ "$(grep -Fc '# cortexkit-managed PATH begin' "$linux_home/.bashrc")" == "1" ]] || fail 'no-op installer duplicated the PATH block'
[[ "$(shasum -a 256 "$linux_manifest" | awk '{print $1}')" == "$manifest_before" ]] || fail 're-run rewrote an existing manifest (setup rows would be lost)'
[[ -f "$linux_sidecar" ]] || fail 're-run did not write the bootstrap sidecar'
assert_mode "$linux_sidecar" 600
grep -Fq "\"archive_sha256\": \"$archive_digest\"" "$linux_sidecar" || fail 'sidecar did not record the archive digest'
grep -Fq "\"sha256\": \"$binary_digest\"" "$linux_sidecar" || fail 'sidecar did not record the placed binary digest'
grep -Fq 'ck-subc' "$linux_manifest" || fail 'daemon row vanished from the manifest'
! grep -Fq 'ck-subc' "$linux_sidecar" || fail 'sidecar carries rows that are not the bootstrap installer'"'"'s'

darwin_home="$test_root/darwin-home"
mkdir -p "$darwin_home"
darwin_output="$test_root/darwin-output"
run_installer "$darwin_home" "$darwin_output" \
  CK_TEST_OS=Darwin CK_TEST_ARCH=arm64 CK_TEST_KERNEL=generic
grep -Fq 'ck-darwin-arm64.zip' "$darwin_home/requests.log" || fail 'Darwin archive name was not requested'
[[ ! -e "$darwin_home/setup-called" ]] || fail 'Darwin installer started the extracted ck process'

# The documented invocation pipes into bash. On Debian and Ubuntu /bin/sh is
# dash, where `set -o pipefail` is fatal before any line of the script runs;
# the guard ahead of it must refuse by name under a POSIX shell. Run the arm
# under dash when the host has one, else under `sh -o posix`-less plain sh.
posix_shell=$(command -v dash || command -v sh)
if out=$("$posix_shell" "$installer" 2>&1); then
  echo "test failure: wrong-shell run unexpectedly succeeded" >&2; exit 1
fi
case "$out" in
  *"refusal: wrong-shell"*"| bash"*) ;;
  *) echo "test failure: wrong-shell refusal missing or unnamed: $out" >&2; exit 1 ;;
esac

expect_refusal() {
  local name="$1"
  local expected="$2"
  shift 2
  local home="$test_root/$name-home"
  local output="$test_root/$name-output"
  mkdir -p "$home"
  if run_installer "$home" "$output" "$@"; then
    fail "$name unexpectedly succeeded"
  fi
  grep -Fq "refusal: $expected" "$output" || {
    cat "$output" >&2
    fail "$name did not emit $expected"
  }
}

# linux-arm64 became a supported tuple when the arm runner leg shipped; the
# refusal fixture keeps a genuinely unsupported architecture.
expect_refusal unsupported-platform unsupported-platform \
  CK_TEST_OS=Linux CK_TEST_ARCH=riscv64 CK_TEST_KERNEL=generic
expect_refusal missing-archive release-incomplete \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic CK_TEST_DOWNLOAD_FAILURE=archive
expect_refusal missing-sidecar release-incomplete \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic CK_TEST_MISSING_ASSET=1
expect_refusal digest-mismatch digest-mismatch \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic CK_TEST_DIGEST_MISMATCH=1
expect_refusal extraction-failed extraction-failed \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic CK_TEST_EXTRACTION_FAILURE=1
expect_refusal wsl-systemd-user-unavailable systemd-user-manager-unavailable \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=microsoft CK_TEST_SYSTEMD_RESULT=1

no_systemd_home="$test_root/no-systemd-home"
mkdir -p "$no_systemd_home"
no_systemd_output="$test_root/no-systemd-output"
if run_installer "$no_systemd_home" "$no_systemd_output" \
  CK_TEST_OS=Linux CK_TEST_ARCH=x86_64 CK_TEST_KERNEL=generic CK_TEST_SYSTEMD_RESULT=1 CK_TEST_SYSTEMD_SYSTEM_RESULT=1; then
  fail 'non-WSL Linux without systemd unexpectedly succeeded'
fi
grep -Fq 'refusal: systemd-unavailable: Linux setup is unsupported' "$no_systemd_output" || {
  cat "$no_systemd_output" >&2
  fail 'non-WSL Linux without systemd did not receive the named refusal'
}
[[ ! -e "$no_systemd_home/requests.log" ]] || fail 'non-WSL systemd refusal downloaded release artifacts'
[[ ! -e "$no_systemd_home/.local/share/cortexkit/bin/ck" ]] || fail 'non-WSL systemd refusal placed ck'

printf 'shell installer tests passed\n'
