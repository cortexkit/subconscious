#!/usr/bin/env bash
set -uo pipefail
finished=

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
detector="$repo_root/scripts/release/unpublished-wire-crates.sh"
test_root=$(mktemp -d)
finish() {
  local rc=$?
  rm -rf "$test_root"
  if [ "$rc" -eq 0 ] && [ "${finished:-}" != 1 ]; then
    echo "unpublished-wire-crates.sh.test: exited early without finishing" >&2
    rc=1
  fi
  exit "$rc"
}
trap finish EXIT
passes=0
failures=0

manifest_version() {
  awk -F'"' '/^version[[:space:]]*=/ { print $2; exit }' \
    "$repo_root/crates/$1/Cargo.toml"
}

write_response() {
  local dir="$1"
  local crate="$2"
  local version="$3"
  cat >"$dir/$crate.json" <<JSON
{"crate":{"max_version":"$version"},"versions":[{"num":"$version"}]}
JSON
}

write_current_responses() {
  local dir="$1"
  mkdir -p "$dir"
  local crate
  for crate in subc-config subc-protocol subc-os subc-transport subc-control subc-client-rs \
    subc-jsonc subc-cgroup subc-uptime subc-jobobject subc-presence \
    subc-daemon cortexkit-bus-testkit; do
    write_response "$dir" "$crate" "$(manifest_version "$crate")"
  done
}

check_case() {
  local name="$1"
  local expected_output="$2"
  local expected_status="$3"
  shift 3
  local stdout_file="$test_root/$name.stdout"
  local stderr_file="$test_root/$name.stderr"

  "$@" >"$stdout_file" 2>"$stderr_file"
  local status=$?
  local output
  output=$(<"$stdout_file")
  if [[ "$status" == "$expected_status" && "$output" == "$expected_output" ]]; then
    printf 'ok: %s\n' "$name"
    passes=$((passes + 1))
    return
  fi

  printf 'not ok: %s (status %s, expected %s)\n' \
    "$name" "$status" "$expected_status" >&2
  printf 'expected stdout: <%s>\nactual stdout: <%s>\n' \
    "$expected_output" "$output" >&2
  if [[ -s "$stderr_file" ]]; then
    printf '%s\n' 'stderr:' >&2
    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <"$stderr_file"
  fi
  failures=$((failures + 1))
}

one_behind="$test_root/one-behind"
write_current_responses "$one_behind"
write_response "$one_behind" subc-protocol 0.1.0
check_case one-behind \
  "subc-protocol $(manifest_version subc-protocol)" 0 \
  bash "$detector" --registry-json-dir "$one_behind"

all_current="$test_root/all-current"
write_current_responses "$all_current"
check_case all-current '' 0 \
  env SUBC_REGISTRY_JSON_DIR="$all_current" bash "$detector"

testkit_new="$test_root/testkit-new"
write_current_responses "$testkit_new"
printf '%s\n' 404 >"$testkit_new/cortexkit-bus-testkit.status"
printf '%s\n' '{"errors":[{"detail":"crate does not exist"}]}' \
  >"$testkit_new/cortexkit-bus-testkit.json"
check_case new-bus-testkit \
  "cortexkit-bus-testkit $(manifest_version cortexkit-bus-testkit)" 0 \
  bash "$detector" --registry-json-dir "$testkit_new"

two_behind="$test_root/two-behind"
write_current_responses "$two_behind"
write_response "$two_behind" subc-transport 0.1.0
write_response "$two_behind" subc-control 0.1.0
check_case dependency-order \
  "subc-transport $(manifest_version subc-transport)
subc-control $(manifest_version subc-control)" 0 \
  bash "$detector" --registry-json-dir "$two_behind"

config_and_dependents="$test_root/config-and-dependents"
write_current_responses "$config_and_dependents"
for crate in subc-config subc-protocol subc-os subc-transport subc-control subc-client-rs; do
  write_response "$config_and_dependents" "$crate" 0.0.0
done
check_case config-and-os-before-their-dependents \
  "subc-config $(manifest_version subc-config)
subc-protocol $(manifest_version subc-protocol)
subc-os $(manifest_version subc-os)
subc-transport $(manifest_version subc-transport)
subc-control $(manifest_version subc-control)
subc-client-rs $(manifest_version subc-client-rs)" 0 \
  bash "$detector" --registry-json-dir "$config_and_dependents"

daemon_and_leaves="$test_root/daemon-and-leaves"
write_current_responses "$daemon_and_leaves"
for crate in subc-config subc-jsonc subc-cgroup subc-uptime subc-os subc-jobobject subc-presence \
  subc-daemon; do
  printf '%s\n' 404 >"$daemon_and_leaves/$crate.status"
  printf '%s\n' '{"errors":[{"detail":"crate does not exist"}]}' \
    >"$daemon_and_leaves/$crate.json"
done
check_case daemon-after-its-leaves \
  "subc-config $(manifest_version subc-config)
subc-os $(manifest_version subc-os)
subc-jsonc $(manifest_version subc-jsonc)
subc-cgroup $(manifest_version subc-cgroup)
subc-uptime $(manifest_version subc-uptime)
subc-jobobject $(manifest_version subc-jobobject)
subc-presence $(manifest_version subc-presence)
subc-daemon $(manifest_version subc-daemon)" 0 \
  bash "$detector" --registry-json-dir "$daemon_and_leaves"

never_published="$test_root/never-published"
write_current_responses "$never_published"
printf '%s\n' 404 >"$never_published/subc-control.status"
printf '%s\n' '{"errors":[{"detail":"crate does not exist"}]}' \
  >"$never_published/subc-control.json"
check_case never-published-404 \
  "subc-control $(manifest_version subc-control)" 0 \
  bash "$detector" --registry-json-dir "$never_published"

stub_dir="$test_root/stubs"
mkdir -p "$stub_dir"
cat >"$stub_dir/curl" <<'STUB'
#!/usr/bin/env bash
exit 7
STUB
chmod +x "$stub_dir/curl"
check_case unreachable-registry '' 2 \
  env PATH="$stub_dir:$PATH" SUBC_CRATES_IO_API_URL=https://unreachable.invalid \
  bash "$detector"
if ! grep -Fq 'refusal: registry request failed' \
  "$test_root/unreachable-registry.stderr"; then
  printf 'not ok: unreachable-registry omitted its refusal reason\n' >&2
  failures=$((failures + 1))
else
  printf 'ok: unreachable-registry refusal reason\n'
  passes=$((passes + 1))
fi

printf 'passes: %d failures: %d\n' "$passes" "$failures"
if ((failures > 0)); then
  exit 1
fi
finished=1
